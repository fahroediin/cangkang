# mock = data contoh di localStorage (pratinjau). supabase = pilot sungguhan.
VITE_DATA_MODE=mock

# Wajib diisi jika VITE_DATA_MODE=supabase. Anon key aman di klien; JANGAN isi service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Nomor WhatsApp owner format 628..., untuk tombol "Tanya lewat WhatsApp" saat lokasi di luar jangkauan.
VITE_OWNER_WA=
