{
  "expo": {
    "name": "PamanKu",
    "slug": "telurfarm-native",
    "version": "6.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "telurfarm",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF5EB"
    },
    "ios": {
      "bundleIdentifier": "com.telurfarm.mobile",
      "buildNumber": "27",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "PamanKu memakai lokasi saat Anda meminta pencarian depo terdekat untuk alamat pengantaran."
      }
    },
    "android": {
      "package": "com.telurfarm.mobile",
      "versionCode": 27,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FAF5EB"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan PamanKu memakai lokasi saat Anda mencari depo terdekat.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-document-picker",
      "expo-sharing"
    ]
  }
}
